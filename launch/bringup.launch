<launch>
  <!-- 定义udp端口参数 -->
  <arg name="robot_name" default="tianbot_mini1" />
  <arg name="port1" default="11411" />
  <arg name="addr1" default="192.168.0.245" />
  <arg name="port2" default="11311" />
  <arg name="addr2" default="192.168.0.55" />

  <!-- 迷你机器人，通信驱动 -->
  <!-- 第一个 rosserial_server 节点 -->
  <node pkg="rosserial_server" type="udp_socket_node" name="rosserial_server1">
    <param name="client_port" value="$(arg port1)" />
    <param name="client_addr" value="$(arg addr1)" />
    <param name="server_port" value="$(arg port1)" />
  </node>
  
  <!-- 第二个 rosserial_server 节点 -->
  <node pkg="rosserial_server" type="udp_socket_node" name="rosserial_server2">
    <param name="client_port" value="$(arg port2)" />
    <param name="client_addr" value="$(arg addr2)" />
    <param name="server_port" value="$(arg port2)" />
  </node>

  <!-- 迷你机器人模型 -->
  <include ns="$(arg robot_name)" file="$(find tianbot_mini)/launch/includes/model.launch.xml">
    <arg name="robot_name" value="$(arg robot_name)" />
  </include>
</launch>
